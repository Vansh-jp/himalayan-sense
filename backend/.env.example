# Database Configuration (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./himalayasense.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/himalayasense

# Security & JWT
JWT_SECRET=super_secret_jwt_key_himalayasense_2026_change_me_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Storage
UPLOAD_DIR=./uploads

# SMTP Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=no-reply@himalayasense.local

# General
FRONTEND_URL=http://localhost:5173
PROJECT_NAME=HimalayaSense
ENVIRONMENT=development
API_V1_STR=/api/v1
ENABLE_SCHEDULER=true
WEATHER_SYNC_INTERVAL_MINUTES=30
